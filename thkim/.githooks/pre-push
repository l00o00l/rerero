#!/bin/sh

while read local_ref local_sha remote_ref remote_sha
do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "Blocked push to protected branch: $remote_ref" >&2
            echo "Push a feature branch and open a PR. A human must merge in GitHub." >&2
            exit 1
            ;;
    esac
done

exit 0
